{
  "version": 2,
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://eco-green-complain.vprotech.online/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://eco-green-complain.vprotech.online/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
