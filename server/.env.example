# Eco Green Solar CMS - Environment Configuration

PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173
JWT_SECRET=ecogreen_solar_cms_secret_key_2026

# ================= WHATSAPP CONFIGURATION =================
# Choose: SIMULATED | META_CLOUD_API | TWILIO
WHATSAPP_PROVIDER=SIMULATED

# Meta WhatsApp Cloud API credentials (Required if WHATSAPP_PROVIDER=META_CLOUD_API)
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_BUSINESS_ACCOUNT_ID=

# Twilio WhatsApp credentials (Required if WHATSAPP_PROVIDER=TWILIO)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ================= EMAIL CONFIGURATION =================
# Choose: SIMULATED | SMTP | SENDGRID
EMAIL_PROVIDER=SIMULATED

# SMTP credentials (e.g., Gmail, Amazon SES, SendGrid, Hostinger)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@ecogreensolar.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="Eco Green Solar Support" <support@ecogreensolar.com>
