{
  "manifest_version": 3,
  "name": "Eco Green Solar — WhatsApp Master Relay",
  "version": "1.0.0",
  "description": "Zero-Ban Automated WhatsApp Dispatcher for Eco Green Solar CMS. Sends customer and technician alerts directly via official WhatsApp Web from the Office Master PC.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://eco-green-complain.vprotech.online/*",
    "https://*.onrender.com/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Eco Green Solar — Master Relay"
  }
}
