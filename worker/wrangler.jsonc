{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eco-green-solar-cms-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "SYSTEM_LOGIN_NAME": "System",
    "SYSTEM_LOGIN_ROLE": "admin"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "eco-green-solar-cms-media"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "8ada220e5c6b47a3a6b4bffcee9ba4bf"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
